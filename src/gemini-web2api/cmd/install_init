#!/bin/bash
# 安装前检查运行环境

if ! command -v python3 > /dev/null 2>&1; then
    echo "未找到 python3，gemini-web2api 无法运行。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null; then
    echo "需要 Python 3.8 或更高版本。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

exit 0
