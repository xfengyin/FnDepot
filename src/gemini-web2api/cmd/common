#!/bin/bash
# gemini-web2api 生命周期脚本公共函数库

APP_NAME="gemini-web2api"
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/info.log"
CONFIG_FILE="${TRIM_PKGVAR}/config.json"

# manifest.service_port 允许写成 "8081,9090" 这样的列表，这里只取第一个
SERVICE_PORT="${TRIM_SERVICE_PORT:-8081}"
SERVICE_PORT="${SERVICE_PORT%%,*}"
[ -n "${SERVICE_PORT}" ] || SERVICE_PORT=8081

log_msg() {
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null || true
}

# 应用中心会把这里的内容展示给用户
log_temp_msg() {
    [ -n "${TRIM_TEMP_LOGFILE}" ] || return 0
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
}

check_process() {
    local pid="$1"
    case "${pid}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "${pid}" 2>/dev/null
}

# 以 TRIM_SERVICE_PORT 为准生成运行时配置，已存在的配置不会被覆盖
seed_config() {
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
    if [ -f "${CONFIG_FILE}" ]; then
        return 0
    fi
    if ! cp "${TRIM_APPDEST}/config.example.json" "${CONFIG_FILE}" 2>/dev/null; then
        log_msg "ERROR: 无法生成配置文件 ${CONFIG_FILE}"
        log_temp_msg "ERROR: 无法生成配置文件 ${CONFIG_FILE}"
        return 1
    fi
    sed -i "s/\"port\": *[0-9]\+/\"port\": ${SERVICE_PORT}/" "${CONFIG_FILE}" 2>/dev/null || true
    log_msg "已生成默认配置 ${CONFIG_FILE}（port=${SERVICE_PORT}）"
    return 0
}

# 生命周期脚本通常以 root 执行，把数据目录交还给应用运行用户
fix_permissions() {
    [ -n "${TRIM_PKGVAR}" ] || return 0
    if [ "$(id -u)" -eq 0 ] && [ -n "${TRIM_USERNAME:-}" ]; then
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME:-${TRIM_USERNAME}}" "${TRIM_PKGVAR}" 2>/dev/null || true
    fi
    return 0
}

health_check() {
    if command -v curl > /dev/null 2>&1; then
        curl -fsS -m 2 "http://127.0.0.1:${SERVICE_PORT}/" > /dev/null 2>&1
    else
        return 0
    fi
}

status_app() {
    [ -f "${PID_FILE}" ] || return 1
    local pid
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    if [ -z "${pid}" ] || ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        return 1
    fi
    health_check
}

start_app() {
    if status_app; then
        log_msg "服务已在运行"
        return 0
    fi

    if ! seed_config; then
        return 1
    fi

    local python_bin
    python_bin="$(command -v python3 2>/dev/null)"
    if [ -z "${python_bin}" ]; then
        log_msg "ERROR: 未找到 python3"
        log_temp_msg "ERROR: 未找到 python3，无法启动 ${APP_NAME}"
        return 1
    fi

    log_msg "启动 ${APP_NAME}（port=${SERVICE_PORT}）"
    rm -f "${PID_FILE}"

    export PYTHONPATH="${TRIM_APPDEST}/server:${TRIM_APPDEST}/vendor"
    # 让 print/日志立即落盘，方便在应用中心查看日志
    export PYTHONUNBUFFERED=1
    cd "${TRIM_APPDEST}/server" || return 1

    if command -v setsid > /dev/null 2>&1; then
        setsid "${python_bin}" -m gemini_web2api --config "${CONFIG_FILE}" --port "${SERVICE_PORT}" >> "${LOG_FILE}" 2>&1 &
    else
        nohup "${python_bin}" -m gemini_web2api --config "${CONFIG_FILE}" --port "${SERVICE_PORT}" >> "${LOG_FILE}" 2>&1 &
    fi
    local pid="$!"
    echo "${pid}" > "${PID_FILE}"

    local count=0
    while [ "${count}" -lt 40 ]; do
        if ! check_process "${pid}"; then
            log_msg "ERROR: 进程已退出，请查看 ${LOG_FILE}"
            log_temp_msg "ERROR: ${APP_NAME} 启动失败，详情见 ${LOG_FILE}"
            rm -f "${PID_FILE}"
            return 1
        fi
        if health_check; then
            log_msg "启动成功，PID=${pid}"
            return 0
        fi
        sleep 0.5
        count=$((count + 1))
    done

    log_msg "WARN: 健康检查超时，进程 PID=${pid} 仍在运行"
    return 0
}

stop_app() {
    log_msg "停止 ${APP_NAME}"
    local pid=""
    if [ -r "${PID_FILE}" ]; then
        pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    fi

    if [ -n "${pid}" ] && check_process "${pid}"; then
        kill -TERM "${pid}" 2>/dev/null || true
        local count=0
        while check_process "${pid}" && [ "${count}" -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        if check_process "${pid}"; then
            log_msg "进程未响应，强制结束 PID=${pid}"
            kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi

    rm -f "${PID_FILE}"
    return 0
}
